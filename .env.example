# Opcional no computador local. npm start carrega .env, quando existir.
PORT=4173
SYNAPSE_DATA_DIR=.runtime
# Em hospedagem, configure estes valores no painel do provedor.
# Nunca use VITE_ para segredos: essas variáveis entram no navegador.
# SYNAPSE_ADMIN_KEY=defina-um-segredo-aleatorio-no-painel
# PUBLIC_BASE_URL=https://seu-dominio.example
# No Render, RENDER_EXTERNAL_URL já informa a origem HTTPS automaticamente.
